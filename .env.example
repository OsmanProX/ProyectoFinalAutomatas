# ============================================================================
# Copiar este archivo como ".env" y llenar los valores (pedirlos al equipo por privado).
# El archivo .env NUNCA se sube a GitHub.
# ============================================================================

# Base de datos MySQL (si la contraseña empieza con #, ponerla entre comillas dobles)
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Servidor
PORT=3000
SESSION_SECRET=
# Opcional: clave para firmar QR y códigos (si falta se usa SESSION_SECRET)
CREDENTIAL_SECRET=

# Correo con Brevo (SMTP)
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Proyecto Automatas <correo@ejemplo.com>"

# WhatsApp con Wawp (prioridad) - app.wawp.net > Dev Tools & API
WAWP_INSTANCE_ID=
WAWP_ACCESS_TOKEN=
# false = PDF con el texto como descripción (1 mensaje); true = texto y PDF por separado (2 mensajes)
WHATSAPP_TEXTO_APARTE=false

# WhatsApp con Green-API (respaldo)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_URL=
GREEN_API_MEDIA_URL=
DEFAULT_COUNTRY_CODE=502

# JWT para la API /api (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=2h

# reCAPTCHA v2 (https://www.google.com/recaptcha/admin). Si faltan, se desactiva.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# true solo en el hosting (detrás de proxy) para guardar la IP real en la bitácora
TRUST_PROXY=false

# Servicio de reconocimiento facial
FACE_API_BASE=

# Opcional: fuente china para el PDF (ruta a .ttf/.otf/.ttc)
PDF_CJK_FONT=
