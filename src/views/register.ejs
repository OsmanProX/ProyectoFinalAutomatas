<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.register_title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
  <link rel="stylesheet" href="/css/photo-studio.css">
  <link rel="stylesheet" href="/css/register-extras.css">
  <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
    <script src="https://www.google.com/recaptcha/api.js?hl=<%= lang %>" async defer></script>
  <% } %>
</head>
<body>
  <%
    const datos = values || {};
  %>
  <div class="lang-switcher">
    <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn-lang"><%= t.switch_lang %></a>
  </div>

  <div class="auth-container">
    <div class="card card-register">
      <h1><%= t.register_title %></h1>

      <div id="formAlert" class="alert alert-error"<%- error ? '' : ' style="display:none"' %>><%= error || '' %></div>

      <form action="/register" method="POST" id="registerForm" novalidate>
        <input type="hidden" id="photo" name="photo" value="<%= datos.photo || '' %>">
        <input type="hidden" id="photo_modified" name="photo_modified" value="<%= datos.photoModified || '' %>">
        <input type="hidden" id="role" name="role" value="analitico">

        <div class="form-row">
          <div class="form-group">
            <label for="full_name"><%= t.register_full_name %></label>
            <input type="text" id="full_name" name="full_name" value="<%= datos.fullName || '' %>" required>
          </div>
          <div class="form-group">
            <label for="nickname"><%= t.register_nickname %></label>
            <input type="text" id="nickname" name="nickname" value="<%= datos.nickname || '' %>" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="role"><%= t.register_role %></label>
            <input type="text" id="role_display" value="<%= t.role_analitico %>" disabled>
            <small class="form-hint"><%= t.register_role_fixed %></small>
          </div>
          <div class="form-group">
            <label for="notification_method"><%= t.register_notification %></label>
            <select id="notification_method" name="notification_method" required>
              <option value="whatsapp" <%= datos.notificationMethod === 'whatsapp' ? 'selected' : '' %>><%= t.notification_whatsapp %></option>
              <option value="correo_electronico" <%= !datos.notificationMethod || datos.notificationMethod === 'correo_electronico' ? 'selected' : '' %>><%= t.notification_email %></option>
              <option value="ambos" <%= datos.notificationMethod === 'ambos' ? 'selected' : '' %>><%= t.notification_both %></option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="email"><%= t.register_email %></label>
          <input type="email" id="email" name="email" value="<%= datos.email || '' %>" required maxlength="254"
                 placeholder="nombre.usuario@correo.com">
          <small class="form-hint"><%= t.register_email_hint %></small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="phoneLocal"><%= t.register_phone %></label>
            <%# País (bandera + código) y número; se envía junto en el campo oculto "phone" %>
            <div class="phone-field" id="phoneField">
              <button type="button" class="phone-country" id="phoneCountryBtn" aria-haspopup="listbox" aria-expanded="false" aria-label="<%= t.register_phone_country %>">
                <img id="phoneFlag" src="https://flagcdn.com/w40/gt.png" alt="GT" width="24" height="18">
                <span id="phoneDial">+502</span>
                <span class="phone-caret">&#9662;</span>
              </button>
              <input type="tel" id="phoneLocal" inputmode="tel" maxlength="20" placeholder="5555 1234" autocomplete="tel-national">
              <ul class="phone-list" id="phoneList" role="listbox" hidden></ul>
            </div>
            <input type="hidden" id="phone" name="phone" value="<%= datos.phone || '' %>">
            <small class="form-hint"><%= t.register_phone_hint %></small>
          </div>
          <div class="form-group">
            <label for="birth_date"><%= t.register_birth_date %></label>
            <input type="date" id="birth_date" name="birth_date" value="<%= datos.birthDate || '' %>"
                   min="1900-01-01" max="<%= new Date().toISOString().slice(0, 10) %>">
            <small class="form-hint birth-date-error" id="birthDateError" aria-live="polite" hidden><%= t.validation_birth_date_invalid %></small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="password"><%= t.register_password %></label>
            <div class="input-password">
              <input type="password" id="password" name="password" required>
              <button type="button" class="btn-eye" id="togglePassword">&#128065;</button>
            </div>
          </div>
          <div class="form-group">
            <label for="confirm_password"><%= t.register_confirm_password %></label>
            <div class="input-password">
              <input type="password" id="confirm_password" name="confirm_password" required>
              <button type="button" class="btn-eye" id="toggleConfirmPassword">&#128065;</button>
            </div>
            <small class="form-hint password-match" id="passwordMatch" aria-live="polite"
                   data-hint="<%= t.register_password_hint %>"
                   data-ok="<%= t.register_password_match %>"
                   data-error="<%= t.register_password_mismatch %>"><%= t.register_password_hint %></small>
          </div>
        </div>

        <div class="photo-section">
          <label><%= t.register_photo %></label>
          <div class="photo-placeholder" id="photoPlaceholder">
            <span class="camera-icon">&#128247;</span>
            <span><%= t.register_photo %></span>
          </div>

          <div id="cameraSection" class="camera-section" style="display:none">
            <div class="camera-picker" id="regCameraBox" hidden>
              <label for="regCamera"><%= t.login_qr_camera %></label>
              <select id="regCamera" data-label="<%= t.login_qr_camera %>"></select>
            </div>
            <video id="regVideo" autoplay muted playsinline class="face-video"></video>
            <canvas id="regCanvas" class="face-canvas"></canvas>
            <div class="camera-controls">
              <button type="button" class="btn btn-sm btn-primary" id="btnCapture"><%= t.register_capture_photo %></button>
              <button type="button" class="btn btn-sm btn-danger" id="btnCancelCamera"><%= t.register_cancel_photo %></button>
            </div>
          </div>

          <div id="cropperSection" class="cropper-section" style="display:none">
            <div class="cropper-container">
              <img id="cropperImage" src="" alt="Crop">
            </div>
            <div class="camera-controls">
              <button type="button" class="btn btn-sm btn-primary" id="btnCrop"><%= t.register_crop_photo %></button>
              <button type="button" class="btn btn-sm btn-danger" id="btnCancelCrop"><%= t.register_cancel_photo %></button>
            </div>
          </div>

          <div id="photoPreview" class="photo-preview" style="display:none">
            <img id="previewImg" src="" alt="Photo">
            <div class="camera-controls">
              <button type="button" class="btn btn-sm btn-edit-photo" id="btnEditPhoto"><%= t.studio_edit_photo %></button>
              <button type="button" class="btn btn-sm btn-danger" id="btnRemovePhoto"><%= t.register_cancel_photo %></button>
            </div>
          </div>

          <div class="photo-options">
            <button type="button" class="btn btn-photo" id="btnCamera"><%= t.register_take_photo %></button>
            <button type="button" class="btn btn-photo" id="btnUpload"><%= t.register_upload_photo %></button>
            <input type="file" id="fileInput" accept="image/*" style="display:none">
          </div>
        </div>

        <%# reCAPTCHA v2: solo aparece si están las claves en .env %>
        <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
          <div class="form-group" style="display:flex;justify-content:center;overflow:hidden">
            <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
          </div>
        <% } %>

        <button type="submit" class="btn btn-primary"><%= t.register_submit %></button>
      </form>

      <p class="link-text">
        <%= t.register_has_account %>
        <a href="/login"><%= t.register_login %></a>
      </p>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <%
    const textosEstudio = {};
    Object.keys(t).filter(function (k) { return k.indexOf('studio_') === 0; }).forEach(function (k) {
      textosEstudio[k.replace('studio_', '')] = t[k];
    });
  %>
  <script>
    window.REGISTER_I18N = {
      photoRequired: "<%= t.register_photo_required %>",
      cameraError: "<%= t.register_camera_error %>",
      invalidImage: "<%= t.register_invalid_image %>"
    };
  </script>
  <script id="studio-i18n" type="application/json"><%- JSON.stringify(textosEstudio).replace(/</g, '\\u003c') %></script>
  <script src="/js/photo-studio.js"></script>
  <script src="/js/camera-picker.js"></script>
  <script src="/js/register-face.js"></script>
  <script src="/js/register-extras.js"></script>
</body>
</html>
