<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.login_title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="lang-switcher">
    <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn-lang"><%= t.switch_lang %></a>
  </div>

  <div class="auth-container">
    <div class="card">
      <h1><%= t.login_title %></h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="username"><%= t.login_username %></label>
          <input type="text" id="username" name="username" required>
        </div>

        <div class="form-group">
          <label for="password"><%= t.login_password %></label>
          <input type="password" id="password" name="password" required>
        </div>

        <button type="submit" class="btn btn-primary"><%= t.login_submit %></button>
      </form>

      <p class="link-text">
        <%= t.login_no_account %>
        <a href="/register"><%= t.login_register %></a>
      </p>
    </div>
  </div>
</body>
</html>
