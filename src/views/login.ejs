<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.login_title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.js"></script>
</head>
<body>
  <div class="lang-switcher">
    <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn-lang"><%= t.switch_lang %></a>
  </div>

  <div class="auth-container">
    <div class="card">
      <h1><%= t.login_title %></h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="nickname"><%= t.login_nickname %></label>
          <input type="text" id="nickname" name="nickname" required>
        </div>

        <div class="form-group">
          <label for="password"><%= t.login_password %></label>
          <input type="password" id="password" name="password" required>
        </div>

        <button type="submit" class="btn btn-primary"><%= t.login_submit %></button>
      </form>

      <div class="face-divider">
        <span><%= t.login_or %></span>
      </div>

      <button type="button" class="btn btn-face" id="btnFaceLogin">
        <%= t.login_face %>
      </button>

      <div id="faceSection" class="face-section" style="display:none">
        <video id="video" autoplay muted playsinline class="face-video"></video>
        <canvas id="canvas" class="face-canvas"></canvas>
        <div class="camera-controls">
          <button type="button" class="btn btn-sm btn-primary" id="btnVerify"><%= t.login_face_verify %></button>
          <button type="button" class="btn btn-sm btn-danger" id="btnCloseCamera"><%= t.login_face_cancel %></button>
        </div>
        <p id="faceStatus" class="face-status"></p>
      </div>

      <p class="link-text">
        <%= t.login_no_account %>
        <a href="/register"><%= t.login_register %></a>
      </p>
    </div>
  </div>

  <script>
    window.FACE_I18N = {
      promptNickname: "<%= t.face_prompt_nickname %>",
      loadingModels: "<%= t.face_loading_models %>",
      cameraError: "<%= t.face_camera_error %>",
      readyHint: "<%= t.face_ready_hint %>",
      detecting: "<%= t.face_detecting %>",
      verifying: "<%= t.face_verifying %>",
      noFace: "<%= t.face_no_face %>",
      verified: "<%= t.face_verified %>",
      noMatch: "<%= t.face_no_match %>",
      userNotFound: "<%= t.face_user_not_found %>",
      noPhoto: "<%= t.face_no_photo %>",
      accountDisabled: "<%= t.face_account_disabled %>",
      connectionError: "<%= t.face_connection_error %>"
    };
  </script>
  <script src="/js/face-login.js"></script>
</body>
</html>
