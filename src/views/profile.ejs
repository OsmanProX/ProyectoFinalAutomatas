<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <script src="/js/theme-init.js"></script>
  <title><%= t.profile_title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/menu.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
  <link rel="stylesheet" href="/css/photo-studio.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/password-match.css">
  <link rel="stylesheet" href="/css/face-guide.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/ui-pro.css">
</head>
<body class="profile-body">

  <!-- SIDEBAR -->
  <%- include('partials/sidebar', { activePage: 'perfil' }) %>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="main-wrapper">
    <header class="topbar">
      <%- include('partials/user-chip') %>
      <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn btn-sm"><%= t.switch_lang %></a>
    </header>

    <main class="profile-page">
      <%
        const EN = lang === 'en';
        const _notif = perfil.notificationMethod === 'whatsapp' ? t.notification_whatsapp : (perfil.notificationMethod === 'ambos' ? t.notification_both : t.notification_email);
      %>
      <%# Portada del perfil: foto con anillo animado + datos principales %>
      <div class="profile-header perfil-hero">
        <div class="perfil-hero-foto-wrap">
          <%# user-chip-avatar: profile.js la actualiza sola al cambiar la foto %>
          <img class="user-chip-avatar perfil-hero-foto" src="/perfil/foto?v=<%= version %>" alt="<%= t.profile_photo_alt %>" width="98" height="98" decoding="async">
          <span class="perfil-hero-estado" title="<%= EN ? 'Active account' : 'Cuenta activa' %>"></span>
        </div>
        <div class="perfil-hero-texto">
          <h1><%= t.profile_title %></h1>
          <p class="perfil-hero-nombre"><%= perfil.fullName || user.full_name %></p>
          <p class="perfil-hero-sub"><%= t.profile_subtitle %></p>
          <ul class="ui-chips">
            <li class="ui-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"/></svg><span><%= perfil.nickname || user.nickname %></span></li>
            <% if (user.role) { %>
            <li class="ui-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span><%= user.role %></span></li>
            <% } %>
            <li class="ui-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg><span><%= _notif %></span></li>
            <% if (credencial) { %>
            <li class="ui-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2.5"/><path d="M14 10h5M14 14h3"/></svg><span><%= credencial.credentialCode %></span></li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="profile-grid">

        <!-- ================= MI FOTO ================= -->
        <section class="profile-card">
          <h2><span class="perfil-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></span><%= t.profile_photo_title %></h2>
          <p class="profile-hint"><%= t.profile_photo_hint %></p>

          <div class="profile-photo-box" id="photoView">
            <img id="profilePhoto" src="/perfil/foto?v=<%= version %>" alt="<%= t.profile_photo_alt %>">
          </div>

          <div id="cameraBox" class="profile-tool" hidden>
            <div class="camera-picker" id="profileCameraBox" hidden>
              <label for="profileCamera"><%= t.login_qr_camera %></label>
              <select id="profileCamera"></select>
            </div>
            <video id="profileVideo" autoplay muted playsinline data-face-guide></video>
            <div class="profile-actions">
              <button type="button" class="btn btn-sm btn-accent" id="btnCapture"><%= t.profile_capture %></button>
              <button type="button" class="btn btn-sm btn-danger" id="btnCancelCamera"><%= t.profile_cancel %></button>
            </div>
          </div>

          <div id="cropBox" class="profile-tool" hidden>
            <div class="profile-crop"><img id="cropImage" src="" alt="Recorte"></div>
            <div class="profile-actions">
              <button type="button" class="btn btn-sm btn-accent" id="btnCrop"><%= t.profile_crop %></button>
              <button type="button" class="btn btn-sm btn-danger" id="btnCancelCrop"><%= t.profile_cancel %></button>
            </div>
          </div>

          <div class="profile-actions" id="photoButtons">
            <button type="button" class="btn btn-sm btn-outline" id="btnTakePhoto"><%= t.profile_take_photo %></button>
            <button type="button" class="btn btn-sm btn-outline" id="btnUploadPhoto"><%= t.profile_upload_photo %></button>
            <input type="file" id="photoFile" accept="image/*" hidden>
          </div>
          <button type="button" class="btn btn-accent btn-block" id="btnCustomize"><%= t.profile_customize %></button>
          <p class="profile-status" id="photoStatus" role="status"></p>
        </section>

        <!-- ================= CONTRASEÑA ================= -->
        <section class="profile-card">
          <h2><span class="perfil-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><%= t.profile_password_title %></h2>
          <form id="passwordForm" novalidate autocomplete="off">
            <div class="form-group">
              <label for="current_password"><%= t.profile_current_password %></label>
              <input type="password" id="current_password" autocomplete="current-password" required maxlength="100">
            </div>
            <div class="form-group">
              <label for="new_password"><%= t.profile_new_password %></label>
              <input type="password" id="new_password" autocomplete="new-password" required minlength="6" maxlength="100">
              <small class="form-hint"><%= t.register_password_limit %></small>
            </div>
            <div class="form-group">
              <label for="confirm_password"><%= t.profile_confirm_password %></label>
              <input type="password" id="confirm_password" autocomplete="new-password" required minlength="6" maxlength="100">
              <small class="form-hint password-match" data-password-match aria-live="polite"
                     data-for="new_password" data-confirm="confirm_password"
                     data-hint="<%= t.register_password_hint %>"
                     data-ok="<%= t.register_password_match %>"
                     data-error="<%= t.register_password_mismatch %>"><%= t.register_password_hint %></small>
            </div>
            <button type="submit" class="btn btn-accent btn-block" id="btnPassword"><%= t.profile_password_submit %></button>
          </form>
          <p class="profile-status" id="passwordStatus" role="status"></p>
        </section>

        <!-- ================= CREDENCIAL Y DATOS ================= -->
        <section class="profile-card">
          <h2><span class="perfil-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2.5"/><path d="M14 10h5M14 14h3"/></svg></span><%= t.profile_credential_title %></h2>
          <% if (credencial) { %>
            <dl class="profile-data">
              <dt><%= t.profile_credential_code %></dt><dd id="credentialCode"><%= credencial.credentialCode %></dd>
              <dt><%= t.profile_credential_issued %></dt><dd><%= new Date(credencial.issuedAt).toLocaleDateString('es-GT') %></dd>
            </dl>
          <% } else { %>
            <p class="profile-hint"><%= t.profile_credential_none %></p>
          <% } %>
          <a class="btn btn-outline btn-block" href="/perfil/credencial" target="_blank" rel="noopener"><%= t.profile_credential_view %></a>
          <button type="button" class="btn btn-outline btn-block" id="btnNewCredential"><%= t.profile_credential_new %></button>
          <div class="profile-confirm" id="confirmBox" hidden>
            <p><%= t.profile_credential_confirm %></p>
            <div class="profile-actions">
              <button type="button" class="btn btn-sm btn-danger" id="btnConfirmNew"><%= t.profile_credential_yes %></button>
              <button type="button" class="btn btn-sm btn-outline" id="btnCancelNew"><%= t.profile_cancel %></button>
            </div>
          </div>
          <p class="profile-status" id="credentialStatus" role="status"></p>

          <h2 class="profile-subtitle"><%= t.profile_data_title %></h2>
          <dl class="profile-data">
            <dt><%= t.profile_email %></dt><dd><%= perfil.email %></dd>
            <dt><%= t.profile_phone %></dt><dd><%= perfil.phone || '—' %></dd>
            <dt><%= t.profile_notification %></dt>
            <dd><%= perfil.notificationMethod === 'whatsapp' ? t.notification_whatsapp : (perfil.notificationMethod === 'ambos' ? t.notification_both : t.notification_email) %></dd>
          </dl>
        </section>
      </div>
    </main>
  </div>

  <%
    const textosPerfil = {};
    Object.keys(t).filter(function (k) { return k.indexOf('profile_') === 0; }).forEach(function (k) { textosPerfil[k] = t[k]; });
    textosPerfil.server_error = t.validation_server_error;
    const textosEstudio = {};
    Object.keys(t).filter(function (k) { return k.indexOf('studio_') === 0; }).forEach(function (k) { textosEstudio[k.replace('studio_', '')] = t[k]; });
  %>
  <script id="profile-i18n" type="application/json"><%- JSON.stringify({ t: textosPerfil, studio: textosEstudio, nickname: user.nickname }).replace(/</g, '\\u003c') %></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="/js/menu.js"></script>
  <script src="/js/photo-studio.js"></script>
  <script src="/js/camera-picker.js"></script>
  <script src="/js/profile.js"></script>
  <script src="/js/password-match.js"></script>
  <script src="/js/face-guide.js"></script>
  <script src="/js/ui-pro.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
