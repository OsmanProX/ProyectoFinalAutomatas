<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.dashboard_title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><%= t.dashboard_title %></div>
    <div class="nav-links">
      <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn btn-sm"><%= t.switch_lang %></a>
      <a href="/logout" class="btn btn-sm btn-danger"><%= t.dashboard_logout %></a>
    </div>
  </nav>

  <div class="container">
    <div class="welcome-section">
      <h1><%= t.dashboard_welcome %>, <%= user.full_name %></h1>
    </div>

    <div class="card card-wide">
      <h2><%= t.dashboard_users %></h2>

      <% if (users.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th><%= t.dashboard_id %></th>
              <th><%= t.dashboard_full_name %></th>
              <th><%= t.dashboard_username %></th>
              <th><%= t.dashboard_state %></th>
              <th><%= t.dashboard_created %></th>
              <th><%= t.dashboard_actions %></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.fullName %></td>
                <td><%= u.username %></td>
                <td>
                  <span class="badge <%= u.state === 1 ? 'badge-active' : 'badge-inactive' %>">
                    <%= u.state === 1 ? t.dashboard_active : t.dashboard_inactive %>
                  </span>
                </td>
                <td><%= new Date(u.createAt).toLocaleDateString() %></td>
                <td>
                  <form action="/users/toggle/<%= u.id %>" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-warning">
                      <%= u.state === 1 ? t.dashboard_inactive : t.dashboard_active %>
                    </button>
                  </form>
                  <form action="/users/delete/<%= u.id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('¿Estás seguro?')">
                    <button type="submit" class="btn btn-sm btn-danger"><%= t.dashboard_actions %></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p class="no-data"><%= t.dashboard_users %> - No data</p>
      <% } %>
    </div>
  </div>
</body>
</html>
