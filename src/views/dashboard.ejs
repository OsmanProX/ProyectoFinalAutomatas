<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.dashboard_title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/menu.css">
</head>
<body>

  <!-- SIDEBAR -->
  <%- include('partials/sidebar', { activePage: 'inicio' }) %>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <%- include('partials/user-chip') %>
      <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn btn-sm"><%= t.switch_lang %></a>
    </header>

    <!-- CONTENIDO -->
    <div class="dashboard-content">

      <div class="welcome-center">
        <h1><%= t.dashboard_welcome %>, <%= user.full_name %></h1>
      </div>

    </div>
  </div>

  <script src="/js/menu.js"></script>
</body>
</html>
