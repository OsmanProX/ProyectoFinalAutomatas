<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <script src="/js/theme-init.js"></script>
  <title><%= t.dashboard_title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/menu.css">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

  <!-- SIDEBAR -->
  <%- include('partials/sidebar', { activePage: 'inicio' }) %>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <%- include('partials/user-chip') %>
      <a href="/lang/<%= lang === 'es' ? 'en' : 'es' %>" class="btn btn-sm"><%= t.switch_lang %></a>
    </header>

    <!-- CONTENIDO -->
    <div class="dashboard-content">

      <% var _roleName = (user && user.role) ? String(user.role).toUpperCase() : ''; %>
      <% if (_roleName === 'ADMIN' || _roleName === 'SUPERVISOR') { %>
      <div class="dashboard-role">
        <span class="role-badge role-badge-active"><%= user.role %></span>
      </div>
      <% } %>

      <div class="welcome-center">
        <h1><%= t.dashboard_welcome %>, <%= user.full_name %></h1>
      </div>

    </div>
  </div>

  <script src="/js/menu.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
