<%
  // Valores por defecto por si la ruta no envía t o lang todavía
  const T = (typeof t !== 'undefined' && t) ? t : {};
  const L = (typeof lang !== 'undefined' && lang) ? lang : 'es';
%>
<!DOCTYPE html>
<html lang="<%= L %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= T.analyze_title || 'Análisis léxico' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/menu.css">
</head>
<body>

  <!-- SIDEBAR -->
  <%- include('partials/sidebar', { activePage: 'analisis' }) %>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <%- include('partials/user-chip') %>
    </header>

    <!-- CONTENIDO -->
    <div class="dashboard-content">
      <div class="card">
        <h1><%= T.analyze_title || 'Análisis léxico' %></h1>
        <p><%= T.analyze_help || 'Carga un archivo de texto (.txt), elige el idioma en que está escrito y presiona Procesar.' %></p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="/analyze" method="POST" enctype="multipart/form-data" id="analyzeForm" novalidate>
          <div class="form-group">
            <label for="file"><%= T.analyze_file || 'Archivo de texto (.txt)' %></label>
            <input type="file" id="file" name="file" accept=".txt,text/plain" required>
          </div>

          <div class="form-group">
            <label for="language"><%= T.analyze_language || 'Idioma del texto' %></label>
            <select id="language" name="language" required>
              <option value="es">Español</option>
              <option value="en">Inglés</option>
              <option value="ru">Ruso</option>
              <option value="zh">Chino</option>
              <option value="ar">Árabe</option>
            </select>
          </div>

          <button type="submit" class="btn"><%= T.analyze_process || 'Procesar' %></button>
        </form>

        <!-- RESULTADOS DEL ANÁLISIS LÉXICO (Inciso e & f) -->
        <% if (typeof result !== 'undefined' && result) { %>
          <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ccc;">

          <div class="analysis-results">
            <h2>Resultados del Análisis Léxico</h2>

            <!-- a. Cantidad total de palabras -->
            <p><strong>Cantidad total de palabras:</strong> <%= result.totalWords %></p>

            <div style="display: flex; gap: 20px; margin-top: 15px; flex-wrap: wrap;">
              <!-- b. Palabras que más se repiten -->
              <div style="flex: 1; min-width: 200px;">
                <h3>Palabras que más se repiten</h3>
                <ul>
                  <% if (result.mostRepeated && result.mostRepeated.length > 0) { %>
                    <% result.mostRepeated.forEach(item => { %>
                      <li><strong><%= item.word %></strong> (<%= item.count %> vez/veces)</li>
                    <% }); %>
                  <% } else { %>
                    <li>No hay palabras repetidas</li>
                  <% } %>
                </ul>
              </div>

              <!-- c. Palabras que menos se repiten -->
              <div style="flex: 1; min-width: 200px;">
                <h3>Palabras que menos se repiten</h3>
                <ul>
                  <% if (result.leastRepeated && result.leastRepeated.length > 0) { %>
                    <% result.leastRepeated.forEach(item => { %>
                      <li><strong><%= item.word %></strong> (<%= item.count %> vez/veces)</li>
                    <% }); %>
                  <% } else { %>
                    <li>No hay datos</li>
                  <% } %>
                </ul>
              </div>
            </div>

            <div style="display: flex; gap: 20px; margin-top: 15px; flex-wrap: wrap;">
              <!-- d. Pronombres personales -->
              <div style="flex: 1; min-width: 200px;">
                <h3>Pronombres Personales</h3>
                <p>
                  <% if (result.pronouns && result.pronouns.length > 0) { %>
                    <%= result.pronouns.join(', ') %>
                  <% } else { %>
                    <em>No se detectaron pronombres.</em>
                  <% } %>
                </p>
              </div>

              <!-- e. Nombres de personas / Sustantivos propios -->
              <div style="flex: 1; min-width: 200px;">
                <h3>Nombres de Personas / Propios</h3>
                <p>
                  <% if (result.properNouns && result.properNouns.length > 0) { %>
                    <%= result.properNouns.join(', ') %>
                  <% } else { %>
                    <em>No se detectaron nombres propios.</em>
                  <% } %>
                </p>
              </div>
            </div>

            <!-- Inciso f: Solicitud de Reporte PDF -->
            <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="report-section">
              <h3>¿Desea recibir un reporte en PDF?</h3>
              <p>Seleccione el medio de notificación por el que desea recibirlo:</p>

              <form action="/analyze/send-report" method="POST" style="display: flex; gap: 10px; align-items: center; margin-top: 10px;">
                <div class="form-group" style="margin: 0;">
                  <select name="notifyChannel" required>
                    <option value="email">Correo electrónico</option>
                    <option value="phone">Teléfono / WhatsApp</option>
                  </select>
                </div>
                <button type="submit" class="btn">Enviar Reporte PDF</button>
              </form>
            </div>

          </div>
        <% } %>

      </div>
    </div>
  </div>

  <script src="/js/menu.js"></script>
</body>
</html>