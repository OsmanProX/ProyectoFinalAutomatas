<%
  // Valores por defecto por si la ruta no envía t o lang todavía
  const T = (typeof t !== 'undefined' && t) ? t : {};
  const L = (typeof lang !== 'undefined' && lang) ? lang : 'es';
%>
<!DOCTYPE html>
<html lang="<%= L %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= T.analyze_title || 'Análisis léxico' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/menu.css">
</head>
<body>

  <!-- SIDEBAR -->
  <%- include('partials/sidebar', { activePage: 'analisis' }) %>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="main-wrapper">

    <!-- TOPBAR -->
    <header class="topbar">
      <%- include('partials/user-chip') %>
    </header>

    <!-- CONTENIDO -->
    <div class="dashboard-content">
      <div class="card">
        <h1><%= T.analyze_title || 'Análisis léxico' %></h1>
        <p><%= T.analyze_help || 'Carga un archivo de texto (.txt), elige el idioma en que está escrito y presiona Procesar.' %></p>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>


        <form action="/analyze" method="POST" enctype="multipart/form-data" id="analyzeForm" novalidate>
          <div class="form-group">
            <label for="file"><%= T.analyze_file || 'Archivo de texto (.txt)' %></label>
            <input type="file" id="file" name="file" accept=".txt,text/plain" required>
          </div>

          <div class="form-group">
            <label for="language"><%= T.analyze_language || 'Idioma del texto' %></label>
            <select id="language" name="language" required>
              <option value="es">Español</option>
              <option value="en">Inglés</option>
            </select>
          </div>

          <button type="submit" class="btn"><%= T.analyze_process || 'Procesar' %></button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/menu.js"></script>
</body>
</html>