// Diagrama de arquitectura con IPs y puertos - Proyecto Final Lenguajes Formales y Autómatas (UMG 2026)
// Generar: dot -Tpng -Gdpi=150 arquitectura.dot -o arquitectura.png
digraph Arquitectura {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.0, pad=0.4, compound=true, newrank=true,
         fontname="DejaVu Sans", fontsize=20, labelloc=t,
         label=<<b>Diagrama de Arquitectura · IPs y Puertos</b><br/><font point-size="12" color="#6b7280">Proyecto Final Lenguajes Formales y Autómatas · UMG 2026 · dominio codemac.site</font>>];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f6fa", color="#1a1a2e", penwidth=1.3, margin="0.18,0.10"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#1a1a2e", penwidth=1.3, arrowsize=0.8];

  // ---------------------------------------------------------------- clientes
  subgraph cluster_clientes {
    label=<<b>Clientes</b>>; style="rounded,dashed"; color="#6b7280"; fontsize=13;
    navegador [label=<<b>Navegador web</b><br/><font point-size="10">PC / celular · Chrome, Firefox, Edge</font><br/><font point-size="10" color="#4361ee">https://codemac.site</font>>];
    cliente_api [label=<<b>Cliente de la API</b><br/><font point-size="10">Postman · Authorization: Bearer &lt;JWT&gt;</font><br/><font point-size="10" color="#4361ee">https://codemac.site/api/*</font>>];
    dev [label=<<b>Equipo de desarrollo</b><br/><font point-size="10">VS Code · PuTTY · WinSCP</font><br/><font point-size="10" color="#4361ee">local: http://localhost:3000</font>>];
  }

  dns [label=<<b>DNS · Hostinger</b><br/><font point-size="10">codemac.site  →  A 212.47.75.12</font><br/><font point-size="10">bd.codemac.site → servidor MySQL</font><br/><font point-size="10">registros de Brevo (DKIM / SPF)</font>>, fillcolor="#eef0f7"];

  // ---------------------------------------------------------------- servidor
  subgraph cluster_vps {
    label=<<b>VPS Contabo · Ubuntu</b><br/><font point-size="12" color="#4361ee">IP pública 212.47.75.12</font>>; style="rounded,filled"; fillcolor="#ffffff"; color="#1a1a2e"; penwidth=2; fontsize=14;
    ssh   [label=<<b>SSH / SFTP</b><br/><font point-size="10">puerto 22 · administración</font>>, fillcolor="#eef0f7"];
    proxy [label=<<b>Entrada HTTPS</b><br/><font point-size="10">puerto 443 (TLS)</font><br/><font point-size="10">puerto 80 → redirige a 443</font>>, fillcolor="#dbe4ff"];
    subgraph cluster_app {
      label=<<b>Contenedor Docker</b> <font point-size="10">(oven/bun:1.3-slim · opcional)</font>>; style="rounded,dashed"; color="#4361ee"; fontsize=12;
      app [shape=plain, label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#1a1a2e" bgcolor="#1a1a2e">
          <tr><td><font color="white"><b>Aplicación web · Bun 1.3 + Express 5</b></font></td></tr>
          <tr><td><font color="#c7cbe0" point-size="10">puerto interno 3000 · EJS · express-session</font></td></tr>
          <tr><td bgcolor="#ffffff" align="left"><font point-size="10">
            • Login: usuario/contraseña · QR · rostro · reCAPTCHA<br align="left"/>
            • Análisis léxico (autómata finito) + reporte PDF<br align="left"/>
            • API REST /api con JWT (HS256)<br align="left"/>
            • Roles y permisos · bitácora de accesos<br align="left"/>
            • Webhook POST /webhooks/wawp/&lt;clave&gt;<br align="left"/></font></td></tr>
          <tr><td bgcolor="#dbe4ff" align="left"><font point-size="10"><b>Reconocimiento facial local</b> · face-api.js (WASM)<br align="left"/>
            SSD MobileNet v1 + 68 puntos + descriptor 128-d<br align="left"/>
            recorte del rostro y comparación (distancia &lt; 0.6)<br align="left"/></font></td></tr>
        </table>>];
    }
  }

  mysql [shape=cylinder, style=filled, fillcolor="#eef0f7", label=<<b>MySQL 8</b><br/><font point-size="10">bd.codemac.site : 3306</font><br/><font point-size="10">8 tablas · utf8mb4</font>>];

  // ---------------------------------------------------------------- servicios externos
  subgraph cluster_ext {
    label=<<b>Servicios externos</b><br/><font point-size="10">la app sale por HTTPS :443 (SMTP :587 para Brevo)</font>>; style="rounded,dashed"; color="#6b7280"; fontsize=13;
    recaptcha [label=<<b>Google reCAPTCHA v2</b><br/><font point-size="10">www.google.com : 443</font><br/><font point-size="10">/recaptcha/api/siteverify</font>>];
    brevo     [label=<<b>Brevo SMTP</b> (correo)<br/><font point-size="10">smtp-relay.brevo.com : 587</font><br/><font point-size="10">STARTTLS · credenciales y códigos</font>>];
    wawp      [label=<<b>Wawp</b> (WhatsApp, principal)<br/><font point-size="10">api.wawp.net : 443</font><br/><font point-size="10">/v2/send/text · /v2/send/pdf</font>>];
    green     [label=<<b>Green-API</b> (WhatsApp, respaldo)<br/><font point-size="10">7107.api.greenapi.com : 443</font><br/><font point-size="10">sendMessage · sendFileByUpload</font>>];
    github    [label=<<b>GitHub</b> (código fuente)<br/><font point-size="10">github.com : 443</font><br/><font point-size="10">rama_Kevin → rama_Combinada → main</font>>];
  }

  // ---------------------------------------------------------------- conexiones
  navegador   -> dns   [style=dotted, color="#6b7280", fontcolor="#6b7280", label="DNS :53"];
  navegador   -> proxy [label="HTTPS :443", color="#4361ee", fontcolor="#4361ee", penwidth=2];
  cliente_api -> proxy [label="HTTPS :443\nBearer JWT", color="#4361ee", fontcolor="#4361ee", penwidth=2];
  dev         -> ssh   [label="SSH :22"];
  dev         -> github [label="git push :443", style=dashed];
  proxy       -> app   [label="HTTP :3000", lhead=cluster_app];
  app         -> mysql [label="TCP :3306\nmysql2", penwidth=2];
  app         -> recaptcha [];
  app         -> brevo     [];
  app         -> wawp      [];
  wawp        -> proxy     [headlabel="webhook\nmessage.ack\n:443", labeldistance=6, labelangle=-25, style=dashed, color="#4361ee", fontcolor="#4361ee", constraint=false];
  app         -> green     [];
  github      -> ssh       [label="git pull (despliegue)", style=dashed, constraint=false, color="#6b7280", fontcolor="#6b7280"];

  leyenda [shape=plain, style="", label=<
    <table border="0" cellborder="0" cellspacing="2" cellpadding="3">
      <tr><td align="left"><b>Leyenda</b></td></tr>
      <tr><td align="left"><font color="#4361ee">━━</font> tráfico de usuarios (entrada HTTPS)  ·  ━━ salida del servidor  ·  ╌╌ asíncrono / despliegue</td></tr>
      <tr><td align="left">Solo se exponen 22, 80 y 443; el 3000 queda interno (Docker publica 3000:3000).</td></tr>
      <tr><td align="left">El webhook de Wawp evita consultar el estado (sin polling): Wawp avisa a la app.</td></tr>
      <tr><td align="left">Las claves (BD, SMTP, JWT, Wawp, Green-API, reCAPTCHA) van en .env, nunca en Git.</td></tr>
    </table>>];
  { rank=same; dns; leyenda; }
  dev -> leyenda [style=invis];
}
